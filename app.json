{
  "expo": {
    "name": "UAS7 Diary",
    "slug": "urticaria-tracking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.urticariatracking"
    },
    "android": {
      "package": "com.example.urticariatracking",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
    "name": "UAS7 Diary 蕁麻疹日記",
      "shortName": "UAS7",
      "lang": "en",
      "description": "UAS7 urticaria diary: record daily wheals + itch scores, compute the weekly UAS7, and visualize the 7-day trend. Works offline.",
      "themeColor": "#1d4ed8",
      "backgroundColor": "#E6F4FE",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": ".",
      "scope": "."
    },
    "plugins": [
      "expo-localization"
    ],
    "locales": {
      "en": "./locales/en.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "experiments": {
      "baseUrl": "/urticaria-tracking"
    },
    "extra": {
      "eas": {
        "projectId": "1a5567ac-c126-4aa5-9131-c4219c007efa"
      }
    },
    "owner": "nhchiu"
  }
}
